{
  "name": "narthex-tv",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "//test": "config.ts demands the DB env vars at import time, so every test file needs them present even though the pure-logic tests never open a connection.",
    "test": "tsc && NARTHEXTV_DB_USER=test NARTHEXTV_DB_PASSWORD=test NARTHEXTV_DB_NAME=test node --test --test-concurrency=1 \"dist/*.test.js\""
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.3"
  }
}
