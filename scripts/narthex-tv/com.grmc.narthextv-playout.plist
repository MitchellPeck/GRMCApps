<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keeps the narthex playout running on the Mac with the UltraStudio attached.

  Install:
    1. Edit ProgramArguments below: the real path to playout.py, and the real
       player URL from Narthex TV -> Screens -> Copy LOCAL link. This runs on
       the same machine as the containers, so it talks to the app over
       loopback: no WAN, no Cloudflare, and the narthex keeps playing through
       an internet outage.
    2. Build ffmpeg first — Homebrew's ffmpegdecklink does not compile against
       a current DeckLink SDK (see build-ffmpeg-decklink.sh), then confirm the
       device name matches what it reports:
         ~/.local/bin/ffmpeg-decklink -sinks decklink
    3. cp com.grmc.narthextv-playout.plist ~/Library/LaunchAgents/
       launchctl load -w ~/Library/LaunchAgents/com.grmc.narthextv-playout.plist

  Stop it with:
    launchctl unload -w ~/Library/LaunchAgents/com.grmc.narthextv-playout.plist

  A LaunchAgent rather than a LaunchDaemon: Blackmagic's Desktop Video driver
  is reached through a logged-in user session. Set the Mac to log that account
  in automatically so a power cut ends with the screen back up.

  Unlike a browser kiosk this needs no display of its own and draws nothing on
  screen, so the Mac can be headless and the account can stay locked.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.grmc.narthextv-playout</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/CHANGEME/GRMCApps/scripts/narthex-tv/playout.py</string>
    <string>--url</string>
    <string>http://127.0.0.1:3010/player?t=CHANGEME</string>
    <string>--device</string>
    <string>UltraStudio Express Monitor 3G</string>
    <string>--mode</string>
    <string>1920x1080@59.94</string>
    <string>--ffmpeg</string>
    <string>/Users/CHANGEME/.local/bin/ffmpeg-decklink</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- If it exits for any reason, bring it straight back. The throttle stops a
       fast crash loop (a device that is unplugged, say) from spinning. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>StandardOutPath</key>
  <string>/tmp/narthex-playout.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/narthex-playout.err.log</string>
</dict>
</plist>
