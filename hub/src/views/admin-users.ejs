<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GRMC Apps — Users</title>
    <link rel="stylesheet" href="/assets/grmc.css" />
    <style>
      .umatrix { width: 100%; border-collapse: collapse; font-size: 13px }
      .umatrix th, .umatrix td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--rule); white-space: nowrap }
      .umatrix th { font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted) }
      .umatrix tbody tr:last-child td { border-bottom: 0 }
      .umatrix td.c, .umatrix th.c { text-align: center }
      .umatrix tr[data-busy="1"] { opacity: .45 }
      .ustatus { font-size: 11px; font-weight: 600; padding: 2px 9px; border-radius: 999px; border: 1px solid currentColor }
      .uwrap { overflow-x: auto }
      .urow-del { background: none; border: 0; cursor: pointer; font-size: 14px; opacity: .5; line-height: 1 }
      .urow-del:hover { opacity: 1 }
      .ulast { color: var(--hint); font-size: 11.5px }
    </style>
  </head>
  <body>
    <header>
      <div class="logo">
        <div class="seal">G</div>
        <div><h1>GRMC Apps</h1><p>Users</p></div>
      </div>
      <div class="hright">
        <a class="btn-hdr" href="/" style="text-decoration:none">Dashboard</a>
        <a class="btn-hdr" href="/auth/logout" style="text-decoration:none">Sign out</a>
      </div>
    </header>

    <div class="layout" style="max-width:1100px">
      <div class="hero">
        <div class="kicker">Access</div>
        <h1>Users</h1>
        <p>Only people listed here can sign in. Tick an app to grant access.</p>
      </div>

      <div id="msg"></div>

      <div class="card" style="padding:18px 20px;margin-bottom:18px">
        <h3 style="font-size:15px;margin:0 0 12px">Add a user</h3>
        <form id="add-form" style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end">
          <label style="flex:1 1 240px">
            <span class="muted" style="display:block;font-size:12px;margin-bottom:4px">Email</span>
            <input type="email" name="email" required placeholder="name@graceresurrection.org" />
          </label>
          <label style="flex:1 1 180px">
            <span class="muted" style="display:block;font-size:12px;margin-bottom:4px">Name (optional)</span>
            <input type="text" name="name" placeholder="Taylor Bacon" />
          </label>
          <button class="btn btn-primary" type="submit">Add user</button>
        </form>
        <p class="muted" style="font-size:12px;margin:10px 0 0">
          No email is sent. The account works the next time that person signs in with Google.
        </p>
      </div>

      <div class="card uwrap" style="padding:6px 10px 2px">
        <table class="umatrix">
          <thead>
            <tr>
              <th>User</th>
              <th>Status</th>
              <th class="c">Admin</th>
              <th class="c">Active</th>
              <% apps.forEach(function (a) { %>
                <th class="c"><%= a.icon || "" %> <%= a.name %></th>
              <% }); %>
              <th class="c"></th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function (u) { %>
              <tr data-id="<%= u.id %>">
                <td>
                  <strong><%= u.name || "—" %></strong><br />
                  <span class="muted"><%= u.email %></span>
                </td>
                <td>
                  <% if (!u.active) { %>
                    <span class="ustatus" style="color:var(--rej-fg)">Disabled</span>
                  <% } else if (!u.google_sub) { %>
                    <span class="ustatus" style="color:var(--pending-fg)">Invited</span>
                  <% } else { %>
                    <span class="ustatus" style="color:var(--ok-fg)">Active</span>
                  <% } %>
                  <% if (u.last_login) { %>
                    <div class="ulast">Last in <%= new Date(u.last_login).toLocaleDateString() %></div>
                  <% } %>
                </td>
                <td class="c">
                  <input type="checkbox" data-field="is_admin" <%= u.is_admin ? "checked" : "" %> />
                </td>
                <td class="c">
                  <input type="checkbox" data-field="active" <%= u.active ? "checked" : "" %> />
                </td>
                <% apps.forEach(function (a) { %>
                  <td class="c">
                    <input type="checkbox" data-app="<%= a.id %>"
                           <%= u.app_ids.indexOf(a.id) !== -1 ? "checked" : "" %> />
                  </td>
                <% }); %>
                <td class="c">
                  <button class="urow-del" data-del="1" title="Delete user">&#128465;</button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <p class="muted" style="font-size:12px;margin-top:14px">
        Administrators manage this screen only — being an administrator does not grant any app.
        Changes take effect on the user's next page load.
      </p>
    </div>

    <script src="/assets/grmc-nav.js"></script>
    <script>
      (function () {
        var msg = document.getElementById("msg");
        var tbody = document.querySelector("tbody");

        function say(text, bad) {
          if (!text) { msg.innerHTML = ""; return; }
          var div = document.createElement("div");
          div.className = "alert " + (bad ? "alert-warn" : "alert-ok");
          div.textContent = text;
          msg.innerHTML = "";
          msg.appendChild(div);
          if (!bad) setTimeout(function () { msg.innerHTML = ""; }, 2500);
        }

        async function send(method, url, body) {
          var res = await fetch(url, {
            method: method,
            headers: body ? { "content-type": "application/json" } : {},
            body: body ? JSON.stringify(body) : undefined,
            credentials: "same-origin",
          });
          var data = await res.json().catch(function () { return {}; });
          if (!res.ok || data.ok === false) {
            throw new Error(data.error || "That didn't work. Try again.");
          }
          return data;
        }

        // Every toggle saves immediately. On failure the checkbox is put back,
        // so the screen never shows a permission the server did not accept.
        tbody.addEventListener("change", async function (ev) {
          var box = ev.target;
          if (box.tagName !== "INPUT") return;
          var row = box.closest("tr");
          var id = row.getAttribute("data-id");
          var wasChecked = box.checked;
          row.setAttribute("data-busy", "1");
          try {
            if (box.dataset.app) {
              await send(wasChecked ? "PUT" : "DELETE", "/api/admin/users/" + id + "/apps/" + box.dataset.app);
              say("Saved.", false);
            } else {
              var patch = {};
              patch[box.dataset.field] = wasChecked;
              await send("PATCH", "/api/admin/users/" + id, patch);
              // Active changes the status pill, so redraw from the server.
              if (box.dataset.field === "active") { location.reload(); return; }
              say("Saved.", false);
            }
          } catch (err) {
            box.checked = !wasChecked;
            say(err.message, true);
          } finally {
            row.removeAttribute("data-busy");
          }
        });

        tbody.addEventListener("click", async function (ev) {
          var btn = ev.target.closest("[data-del]");
          if (!btn) return;
          var row = btn.closest("tr");
          var who = row.querySelector(".muted").textContent.trim();
          if (!confirm("Delete " + who + "? They will lose access immediately.")) return;
          row.setAttribute("data-busy", "1");
          try {
            await send("DELETE", "/api/admin/users/" + row.getAttribute("data-id"));
            row.remove();
            say("User deleted.", false);
          } catch (err) {
            row.removeAttribute("data-busy");
            say(err.message, true);
          }
        });

        document.getElementById("add-form").addEventListener("submit", async function (ev) {
          ev.preventDefault();
          var form = ev.target;
          try {
            await send("POST", "/api/admin/users", {
              email: form.email.value,
              name: form.name.value,
            });
            location.reload();
          } catch (err) {
            say(err.message, true);
          }
        });
      })();
    </script>
  </body>
</html>
