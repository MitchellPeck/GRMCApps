# ---- Domain ----
# Every host + URL derives from this. hub.<BASE_DOMAIN>, <app>.<BASE_DOMAIN>.
BASE_DOMAIN=grmc.app

# ---- Hub session ----
# Use a long random string (>=32 chars), e.g. `openssl rand -hex 32`
SESSION_SECRET=replace-with-32+char-random-string

# ---- Google OIDC ----
# Create a Web Application OAuth client in Google Cloud Console.
# Authorized redirect URI MUST be: https://hub.grmc.app/auth/callback
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# ---- Postgres superuser (container bootstrap) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=postgres

# ---- Per-app databases (created by db/init/01-databases.sh) ----
HUB_DB_NAME=hub
HUB_DB_USER=hub_user
HUB_DB_PASSWORD=replace-hub-db-password

WHOAMI_DB_NAME=whoami
WHOAMI_DB_USER=whoami_user
WHOAMI_DB_PASSWORD=replace-whoami-db-password

SOCIALPOSTS_DB_NAME=socialposts
SOCIALPOSTS_DB_USER=socialposts_user
SOCIALPOSTS_DB_PASSWORD=replace-socialposts-db-password

APPROVALS_DB_NAME=approvals
APPROVALS_DB_USER=approvals_user
APPROVALS_DB_PASSWORD=replace-approvals-db-password

MEETINGMINUTES_DB_NAME=meetingminutes
MEETINGMINUTES_DB_USER=meetingminutes_user
MEETINGMINUTES_DB_PASSWORD=replace-meetingminutes-db-password

EXPENSES_DB_NAME=expenses
EXPENSES_DB_USER=expenses_user
EXPENSES_DB_PASSWORD=replace-expenses-db-password

# ---- TLS (Let's Encrypt via Cloudflare DNS-01) ----
# Email for Let's Encrypt registration/expiry notices.
ACME_EMAIL=you@example.com
# Cloudflare API token scoped to Zone:DNS:Edit for the BASE_DOMAIN zone.
CF_DNS_API_TOKEN=replace-with-cloudflare-dns-edit-token

# ---- Transcription (self-hosted whisper) ----
# These override the defaults in docker-compose.yml. Leaving one unset is fine;
# setting it to the wrong value silently undoes a tuning decision, so the
# reasoning is spelled out here.
#
# English-only weights. `small.en` is BOTH faster and more accurate on English
# than the multilingual `small` — do not drop the `.en`.
#
# To prioritise ACCURACY over speed, use `large-v3-turbo` instead. It is a
# distilled large model: far more accurate than small.en on names, numbers and
# crosstalk, at a fraction of the cost of `large-v3` (which is the most accurate
# option available but impractically slow on CPU). Raise WHISPER_BEAM to 5 at
# the same time, and raise WHISPER_TIMEOUT_MS on the meeting-minutes service —
# a bigger model can push an hour-long recording past the 4h default.
# Benchmark on a 5-minute clip before trusting it with a whole meeting: the app
# logs `whisper Xs ... realtime factor Y` for every job.
WHISPER_MODEL=small.en
# CPU threads for inference. Set this to the host's PERFORMANCE core count, not
# its total core count: threads that land on efficiency cores hold up the whole
# batch. On Apple Silicon, `sysctl -n hw.perflevel0.physicalcpu` reports it, and
# it must also be <= the CPUs allocated to the Docker VM (`docker info`).
WHISPER_THREADS=6
# Greedy decoding: 2-3x faster than the default beam of 5, with negligible
# accuracy loss on CLEAN English speech. Raise to 5 for accuracy-first — it
# helps most exactly where meeting audio is hardest: crosstalk, a distant
# talker, and unfamiliar proper nouns.
WHISPER_BEAM=1
# int8 is the documented recommendation for CPU inference.
WHISPER_COMPUTE_TYPE=int8
# Speaker clustering: lower = more speakers, higher = fewer. 0.5 split four
# people in a room into eight voices; 0.7 is the tuned value.
WHISPER_DIARIZE_THRESHOLD=0.7
